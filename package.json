{
  "name": "ha-eufy-sdk-bridge",
  "version": "0.2.13",
  "private": true,
  "type": "module",
  "description": "WebSocket + HTTP bridge exposing the eufy-sdk SDK to a frontend (Home Assistant, a web UI, anything), with go2rtc for live video.",
  "main": "server.mjs",
  "bin": {
    "eufy-sdk-bridge": "bin/start.sh"
  },
  "scripts": {
    "start": "node server.mjs",
    "test": "node --test test/*.test.mjs",
    "lint": "prettier --check .",
    "format": "prettier --write ."
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "dependencies": {
    "@razzledazzlebazzle/eufy-sdk": "github:RazzleDazzleBazzle/eufy-sdk#v0.1.5",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "prettier": "^3.3.3"
  }
}
